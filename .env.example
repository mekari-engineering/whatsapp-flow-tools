# WhatsApp Flow Hospital Booking System Configuration

# RSA Decryption Configuration
# Passphrase for the RSA private key
RSA_PASSPHRASE=your_rsa_passphrase_here

# RSA private key for decrypting AES key from WhatsApp
# Note: Replace with your actual private key, keeping the format with proper line breaks
RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
Proc-Type: 4,ENCRYPTED
DEK-Info: DES-EDE3-CBC,YOUR_DEK_INFO_HERE

YOUR_ENCRYPTED_PRIVATE_KEY_CONTENT_HERE
REPLACE_WITH_YOUR_ACTUAL_PRIVATE_KEY_DATA
...
-----END RSA PRIVATE KEY-----"

# API Endpoints Configuration
# Base URL for the n8n webhook endpoints
API_BASE_URL=https://your-n8n-instance.domain.com

# Specific webhook endpoints (will be constructed from base URL)
API_SIGNUP_ENDPOINT=/webhook/signup
API_SIGNIN_ENDPOINT=/webhook/sign_in
API_BOOKING_ENDPOINT=/webhook/submitbooking

# Environment Configuration
NODE_ENV=development

# Demo mode switch (single flag for all demo mocks)
DEMO_MODE=false

# Demo-only sign-in mock (active only when DEMO_MODE=true)
SIGNIN_MOCK_NAME_OR_PHONE=demo_user
SIGNIN_MOCK_BIRTH_DATE=1990-01-01
SIGNIN_MOCK_USER_ID=demo-user-001

# Demo-only booking mock (active only when DEMO_MODE=true)
# If BOOKING_MOCK_USER_ID_MATCH is set, mock only applies when booking payload user_id matches this value
BOOKING_MOCK_USER_ID_MATCH=demo-user-001
BOOKING_MOCK_CODE=DEMO-BOOK-001
BOOKING_MOCK_QR=https://example.com/qr/demo-book-001
BOOKING_MOCK_QUEUE=A-001
BOOKING_MOCK_ROOM=Ruang Demo 1

# Optional: Add any additional configuration
# HOSPITAL_NAME=Your Hospital Name
# TIMEZONE=Asia/Jakarta